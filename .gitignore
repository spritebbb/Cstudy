# ===== 密钥，绝对不能进仓库 =====
.env

# ===== Python =====
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# ===== 打包产物（PyInstaller 生成，几百 MB，不进仓库）=====
dist/
build/
*.spec

# ===== 运行时数据（整个目录一律不进仓库）=====
# 含：答题库、B 站登录 cookie、题库导入缓存、学习笔记导出、备份
# 程序启动时会自动 mkdir，所以仓库里不需要保留这个目录
data/
logs/

# ===== 生成的学习笔记（每次导入都会新增，是产物不是源码）=====
notes/

# ===== 临时文件 =====
*.tmp
*.part
data/tmp/

# ===== 操作系统 =====
Thumbs.db
desktop.ini
.DS_Store

# ===== 编辑器 =====
.vscode/
.idea/

# ===== Claude Code 本机个人设置（每台机器不同，不进仓库）=====
.claude/settings.local.json

# ===== 备份文件 =====
*.bak

# ===== 与本项目无关的个人资料 =====
docs/eNSP*
docs/实操对照手册-*
